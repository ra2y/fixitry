# ---------- Frontend (public; copied into the browser bundle) ----------
# Put this in .env.local. It is only a URL, not a secret.
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud

# ---------- Worker (private; never prefix with VITE_) ----------
CONVEX_URL=https://your-deployment-name.convex.cloud
WORKER_SECRET=replace-with-a-long-random-string
FACTORY_API_KEY=replace-with-your-factory-key
DEMO_REPOSITORY_URL=https://github.com/YOUR-USER/fixitry-vulnerable-demo
# Python used to build the test venv. The demo pins pytest 7.1.2, which needs Python 3.8-3.13.
FIXITRY_PYTHON=python3.13
# Convex dashboard env: ALLOWED_REPOSITORIES=https://github.com/YOUR-USER/fixitry-vulnerable-demo

# ---------- Semgrep (worker; not secret) ----------
# Defaults to Docker mode locally. Deployed worker images use local mode.
SEMGREP_IMAGE=semgrep/semgrep:1.182.1

# ---------- Later phases only ----------
GITHUB_TOKEN=replace-only-if-branch-creation-is-added

# ---------- ZAP (worker; not secret) ----------
ZAP_IMAGE=ghcr.io/zaproxy/zaproxy:2.17.0
# Defaults shown; only change them for a different target app.
# ZAP_TARGET_PORT=5000
# ZAP_HEALTH_PATH=/health
# ZAP_OPENAPI_FILE=openapi.yaml